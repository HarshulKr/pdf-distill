{
  "name": "pdf-distill",
  "description": "Convert PDFs to clean, compact Markdown locally in the browser to save AI tokens.",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "fixtures": "tsx scripts/make-fixtures.ts",
    "convert": "tsx scripts/convert.ts",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "js-tiktoken": "1.0.21",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "pdf-lib": "1.17.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3",
    "wxt": "0.21.4"
  }
}
